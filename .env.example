# Copy this file to ".env" (same folder) and fill in your key.
# ".env" is git-ignored, so the key is never committed.

# Google AI Studio key (https://aistudio.google.com/) - used for models named "gemini-..."
GEMINI_API_KEY=

# Default model. Change this one line to switch models.
MLLM_MODEL=gemini-3.8-flash

# Optional: any OpenAI-compatible provider (OpenAI, OpenRouter, local Ollama) for non-Gemini models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
